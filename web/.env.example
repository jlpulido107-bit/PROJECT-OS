# PROJECT-OS V1.2 — dashboard web (copiar a .env.local; NUNCA versionar .env.local)
# Ninguna variable usa el prefijo NEXT_PUBLIC_: todas se quedan en el servidor.

# --- Datos ---------------------------------------------------------------
# "sheets" lee la Google Sheet real; "fixtures" usa datos sintéticos (sin credenciales de Google).
DASHBOARD_DATA_SOURCE=sheets
# Caché en memoria del servidor, en segundos (0–300). El botón "Actualizar datos" la invalida.
DASHBOARD_CACHE_SECONDS=60
# Mismo ID que config/projects.json (no es un secreto, pero la hoja NO debe compartirse por enlace).
SHEETS_SPREADSHEET_ID=16UXe7fm90fOTTVJhI_RZ8__I876u2buvjeLGr5cJ-Ic

# Cuenta de servicio de Google (solo servidor). Usa UNA de las dos opciones:
#  a) Ruta a la clave JSON guardada FUERA del repositorio (recomendado en local).
PROJECT_OS_GOOGLE_SERVICE_ACCOUNT_FILE=
#  b) JSON completo en una sola línea (recomendado en hosting con gestor de secretos).
PROJECT_OS_GOOGLE_SERVICE_ACCOUNT_JSON=

# --- Autenticación (NextAuth v4 + Google OAuth) -----------------------------
# URL pública del panel. En local: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
# Secreto aleatorio ≥ 32 bytes para cifrar la cookie de sesión: `openssl rand -base64 32`
NEXTAUTH_SECRET=
# Cliente OAuth "Aplicación web" de Google Cloud.
# URI de redirección autorizada: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Correos autorizados, separados por coma. Vacío = nadie puede entrar.
AUTH_ALLOWED_EMAILS=
# Duración máxima de la sesión en segundos (por defecto 8 h; máximo 7 días).
AUTH_SESSION_MAX_AGE_SECONDS=28800

# --- Operaciones V1.4 (escritura) -------------------------------------------
# disabled (por defecto) = nadie escribe. mock = escritura SIMULADA en memoria, solo con
# DASHBOARD_DATA_SOURCE=fixtures y fuera de Cloud Run. sheets = reconocido pero BLOQUEADO en V1.4.
# Runbook: docs/operaciones-v1-4.md
PROJECT_OS_WRITE_MODE=disabled
# Correos con permiso de escritura (subconjunto de AUTH_ALLOWED_EMAILS). Vacío = nadie escribe.
AUTH_WRITER_EMAILS=
